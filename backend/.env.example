# Copy this to .env and fill in your keys

# Admin dashboard password (change this before going live)
ADMIN_TOKEN=spmc2025

# Server port
PORT=3001

# ── RAZORPAY (online payments) ─────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── WHATSAPP CLOUD API (automated notifications) ───────────
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Requires a verified Meta Business account + approved message templates
WA_TOKEN=EAAxxxxxxxxxx
WA_PHONE_ID=1234567890

# WhatsApp message template names (must match your approved templates in Meta Business Manager)
WA_TPL_CONFIRMED=order_confirmed
WA_TPL_DISPATCHED=order_dispatched
WA_TPL_DELIVERED=order_delivered

# Your WhatsApp business number (for wa.me fallback links)
SPMC_WHATSAPP=917200915142
